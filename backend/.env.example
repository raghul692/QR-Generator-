# ===== QRMaster Pro Backend Configuration =====

# Application
APP_NAME=QRMaster Pro
APP_VERSION=1.0.0
DEBUG=False
API_V1_PREFIX=/api/v1

# Backend host/port
HOST=0.0.0.0
PORT=8000

# Supabase PostgreSQL Database (Set your Supabase Session Pooler or Direct connection URI)
# e.g. postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=True

# Supabase Storage & Cloud Credentials (Server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=qr-assets

# CORS & URL Configuration
FRONTEND_ORIGIN=https://your-frontend.vercel.app
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
PUBLIC_REDIRECT_BASE_URL=https://your-backend.onrender.com

# Storage directories
GENERATED_QR_DIR=app/generated_qr
UPLOADS_DIR=app/uploads
EXPORTS_DIR=app/exports
LOGS_DIR=app/logs
BACKUP_DIR=app/backups

# Default QR settings
DEFAULT_QR_SIZE=400
DEFAULT_ERROR_CORRECTION=H
DEFAULT_FOREGROUND_COLOR=#000000
DEFAULT_BACKGROUND_COLOR=#FFFFFF
